@model WorkUp.ViewModels.ClientAccounts.ClientRecoverPasswordViewModel
@{
    ViewData["Title"] = "Recuperar mi contraseña";
    var slug = ViewContext.RouteData.Values["slug"] as string ?? "";
}
<section class="public-booking" aria-labelledby="account-recover-title">
    <h1 id="account-recover-title">Recuperar mi contraseña</h1>
    <p>Escribí tu email y, si tenés una cuenta en @ViewData["BusinessName"], te enviamos un enlace para elegir una contraseña nueva.</p>

    <form method="post" action="/r/@slug/cuenta/recuperar" class="form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="notice notice-error" role="alert"></div>
        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" autocomplete="email" maxlength="254" required />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="actions">
            <button class="btn btn-primary btn-block" type="submit">Enviar enlace</button>
        </div>
    </form>

    <p class="muted">El enlace vence a los 30 minutos y sirve una sola vez. <a href="/r/@slug/cuenta/ingresar">Volver a ingresar</a>.</p>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model WorkUp.ViewModels.ClientAccounts.ClientVerifyEmailViewModel
@{
    ViewData["Title"] = "Confirmá tu cuenta";
    var slug = ViewContext.RouteData.Values["slug"] as string ?? "";
}
<section class="public-booking" aria-labelledby="account-verify-title">
    <h1 id="account-verify-title">Confirmá tu cuenta</h1>
    <p>Confirmá tu email para crear tu cuenta y gestionar tus turnos con @ViewData["BusinessName"].</p>

    <form method="post" action="/r/@slug/cuenta/verificar" class="form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="notice notice-error" role="alert"></div>
        <input asp-for="Token" type="hidden" />
        <div class="actions">
            <button class="btn btn-primary btn-block" type="submit">Confirmar mi cuenta</button>
        </div>
    </form>

    <p class="muted">El enlace vence a las 48 horas y sirve una sola vez. Si ya venció, <a href="/r/@slug/cuenta/reenviar">pedí uno nuevo</a>.</p>
</section>

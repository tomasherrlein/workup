@model WorkUp.ViewModels.ClientAccounts.ClientResendVerificationViewModel
@inject Microsoft.Extensions.Options.IOptions<WorkUpOptions> Options
@{
    ViewData["Title"] = "Pedir un enlace nuevo";
    var slug = ViewContext.RouteData.Values["slug"] as string ?? "";
    // The sentence stays conditional (RF-27) and only the mode decides what it says about the link.
    var prompt = EmailDeliveryCopy.ResendPrompt(
        EmailDeliveryCopy.ResolveMode(Options.Value.Email?.Mode), ViewData["BusinessName"] as string);

    // A field only claims aria-invalid="true" when the server marked that exact field in ModelState. On a valid
    // rerender the expression is null, so the attribute is not rendered at all and nothing announces a false error.
    bool ServerMarkedInvalid(string field) =>
        ViewData.ModelState.TryGetValue(field, out var entry) && entry.Errors.Count > 0;
}
<section class="public-booking" aria-labelledby="account-resend-title">
    <h1 id="account-resend-title">Pedir un enlace nuevo</h1>
    <p>@prompt</p>

    <form method="post" action="/r/@slug/cuenta/reenviar" class="form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="notice notice-error" role="alert"></div>
        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" autocomplete="email" maxlength="254" required
                   aria-describedby="account-resend-email-error"
                   aria-invalid="@(ServerMarkedInvalid("Email") ? "true" : null)" />
            <span asp-validation-for="Email" id="account-resend-email-error" class="field-error"></span>
        </div>
        <div class="actions">
            <button class="btn btn-primary btn-block" type="submit">Enviar enlace nuevo</button>
        </div>
    </form>

    <p class="muted"><a href="/r/@slug/cuenta/ingresar">Volver a ingresar</a>.</p>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

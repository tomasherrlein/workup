@model WorkUp.ViewModels.ClientAccounts.ClientResendVerificationViewModel
@{
    ViewData["Title"] = "Pedir un enlace nuevo";
    var slug = ViewContext.RouteData.Values["slug"] as string ?? "";
}
<section class="public-booking" aria-labelledby="account-resend-title">
    <h1 id="account-resend-title">Pedir un enlace nuevo</h1>
    <p>Si tu cuenta todavía no está confirmada en @ViewData["BusinessName"], te enviamos otro enlace de confirmación.</p>

    <form method="post" action="/r/@slug/cuenta/reenviar" class="form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="notice notice-error" role="alert"></div>
        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" autocomplete="email" maxlength="254" required />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="actions">
            <button class="btn btn-primary btn-block" type="submit">Enviar enlace nuevo</button>
        </div>
    </form>

    <p class="muted"><a href="/r/@slug/cuenta/ingresar">Volver a ingresar</a>.</p>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

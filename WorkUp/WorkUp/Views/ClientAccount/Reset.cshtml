@model WorkUp.ViewModels.ClientAccounts.ClientResetPasswordViewModel
@{
    ViewData["Title"] = "Elegí tu contraseña nueva";
    var slug = ViewContext.RouteData.Values["slug"] as string ?? "";

    // A field only claims aria-invalid="true" when the server marked that exact field in ModelState. On a valid
    // rerender the expression is null, so the attribute is not rendered at all and nothing announces a false error.
    bool ServerMarkedInvalid(string field) =>
        ViewData.ModelState.TryGetValue(field, out var entry) && entry.Errors.Count > 0;
}
<section class="public-booking" aria-labelledby="account-reset-title">
    <h1 id="account-reset-title">Elegí tu contraseña nueva</h1>
    <p>Vas a usar esta contraseña para ingresar a tu cuenta de @ViewData["BusinessName"].</p>

    <form method="post" action="/r/@slug/cuenta/restablecer" class="form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="notice notice-error" role="alert"></div>
        <input asp-for="Token" type="hidden" />
        <div class="field">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="8" maxlength="100" required
                   aria-describedby="account-reset-new-password-error"
                   aria-invalid="@(ServerMarkedInvalid("NewPassword") ? "true" : null)" />
            <p class="hint">Al menos 8 caracteres.</p>
            <span asp-validation-for="NewPassword" id="account-reset-new-password-error" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="100" required
                   aria-describedby="account-reset-confirm-password-error"
                   aria-invalid="@(ServerMarkedInvalid("ConfirmPassword") ? "true" : null)" />
            <span asp-validation-for="ConfirmPassword" id="account-reset-confirm-password-error" class="field-error"></span>
        </div>
        <div class="actions">
            <button class="btn btn-primary btn-block" type="submit">Guardar contraseña</button>
        </div>
    </form>

    <p class="muted">El enlace vence a los 30 minutos y sirve una sola vez.</p>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@{
    Layout = "_Layout";
    var businessName = ViewData["BusinessName"] as string ?? "WorkUp";
    var homeUrl = ViewData["HomeUrl"] as string ?? "/";
}
<header class="public-header on-frame">
    <div class="inner">
        <a class="title" href="@homeUrl">@businessName</a>
        @await RenderSectionAsync("HeaderActions", required: false)
    </div>
</header>
<main id="main" class="public-content" tabindex="-1">
    <partial name="_Flash" />
    @RenderBody()
</main>
@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}

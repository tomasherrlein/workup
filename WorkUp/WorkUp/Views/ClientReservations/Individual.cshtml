@using WorkUp.ViewModels.ClientPanel
@model ClientIndividualReservationViewModel
@{
    Layout = "_ClientLayout";
    ViewData["Title"] = "Reservar turno";
}
<section class="public-booking" aria-labelledby="client-reserve-title">
    <h1 id="client-reserve-title">Reservar turno</h1>
    <p>Elegí el servicio, la trabajadora, el día y el horario.</p>
    <a class="btn" href="/r/@Model.Slug/mis-turnos">Volver a mis turnos</a>
</section>

@* The chosen start is only a proposal: the save revalidates it under lock, so it may be taken by the time it is
   confirmed. The screen never shows the private link token, an owner remark or a health observation. *@
<p class="notice notice-warning">El horario se valida al guardar y puede ocuparse mientras tanto.</p>
<div asp-validation-summary="ModelOnly" class="notice notice-error" role="alert"></div>

@if (!Model.HasServices)
{
    <div class="empty-state" role="status">
        <p>@ClientIndividualReservationViewModel.NoServicesMessage</p>
    </div>
}
else
{
    <form method="get" action="/r/@Model.Slug/mis-turnos/reservar/turno" class="agenda-filters" aria-label="Elegir servicio, trabajadora y día">
        <div class="field">
            <label for="serviceId">Servicio</label>
            <select id="serviceId" name="serviceId">
                @foreach (var service in Model.Services)
                {
                    <option value="@service.Id" selected="@(service.Id == Model.Input.ServiceId ? "selected" : null)">@service.Name</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="workerId">Trabajadora</label>
            <select id="workerId" name="workerId">
                @foreach (var worker in Model.Workers)
                {
                    <option value="@worker.Id" selected="@(worker.Id == Model.Input.WorkerId ? "selected" : null)">@worker.FullName</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="date">Día</label>
            <input id="date" name="date" type="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn">Ver horarios</button>
    </form>

    @if (!Model.HasWorkers)
    {
        <div class="empty-state" role="status">
            <p>@ClientIndividualReservationViewModel.NoWorkersMessage</p>
        </div>
    }
    else if (!Model.HasSlots)
    {
        <div class="empty-state" role="status">
            <p>@ClientIndividualReservationViewModel.NoSlotsMessage</p>
            @if (Model.NearestAlternative is { } noSlotNearest)
            {
                <a class="btn-primary" href="/r/@Model.Slug/mis-turnos/reservar/turno?serviceId=@Model.Input.ServiceId&workerId=@Model.Input.WorkerId&date=@DateOnly.FromDateTime(noSlotNearest).ToString("yyyy-MM-dd")">
                    Horario más cercano: @Formatting.LongDate(DateOnly.FromDateTime(noSlotNearest)), @Formatting.Time(noSlotNearest)
                </a>
            }
        </div>
    }
    else
    {
        <form method="post" action="/r/@Model.Slug/mis-turnos/reservar/turno" class="form">
            @Html.AntiForgeryToken()
            <input asp-for="Input.ServiceId" type="hidden" />
            <input asp-for="Input.WorkerId" type="hidden" />
            <input asp-for="Input.Date" type="hidden" />
            <div class="field">
                <label asp-for="Input.StartTime">Horario</label>
                <select asp-for="Input.StartTime">
                    <option value="">Elegí un horario</option>
                    @foreach (var startTime in Model.AvailableStartTimes)
                    {
                        <option value="@startTime.ToString("HH:mm")">@Formatting.Time(Model.Date.ToDateTime(startTime))</option>
                    }
                </select>
                <span asp-validation-for="Input.StartTime"></span>
            </div>
            @if (Model.NearestAlternative is { } nearest)
            {
                <p class="row-sub">
                    Horario más cercano:
                    <a href="/r/@Model.Slug/mis-turnos/reservar/turno?serviceId=@Model.Input.ServiceId&workerId=@Model.Input.WorkerId&date=@DateOnly.FromDateTime(nearest).ToString("yyyy-MM-dd")">
                        @Formatting.LongDate(DateOnly.FromDateTime(nearest)), @Formatting.Time(nearest)
                    </a>
                </p>
            }
            <button type="submit" class="btn-primary">Confirmar reserva</button>
        </form>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

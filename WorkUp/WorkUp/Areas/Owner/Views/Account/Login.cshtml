@model LoginViewModel
@{
    ViewData["Title"] = "Ingresar";
    Layout = "_PublicLayout";
}
<div class="page-header">
    <div>
        <h1>Ingresar</h1>
        <p>Accedé al panel de gestión de tu negocio.</p>
    </div>
</div>

<form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" class="form" novalidate>
    <div asp-validation-summary="ModelOnly" class="notice notice-error" role="alert"></div>
    <div class="field">
        <label asp-for="Username"></label>
        <input asp-for="Username" autocomplete="username" autofocus />
        <span asp-validation-for="Username" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="Password"></label>
        <input asp-for="Password" autocomplete="current-password" />
        <span asp-validation-for="Password" class="field-error"></span>
    </div>
    <div class="actions">
        <button type="submit" class="btn btn-primary btn-block">Ingresar</button>
    </div>
</form>

<p><a asp-action="Register">¿Todavía no tenés cuenta? Registrá tu negocio.</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

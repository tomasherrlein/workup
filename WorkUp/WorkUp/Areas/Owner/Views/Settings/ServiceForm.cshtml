@model ServiceFormViewModel
@{
    var serviceId = ViewData["ServiceId"] as int?;
    var actionName = serviceId.HasValue ? "EditService" : "CreateService";
}
<div class="page-header">
    <div>
        <h1>@ViewData["Title"]</h1>
    </div>
</div>

<form asp-action="@actionName" method="post" class="form" novalidate>
    <div asp-validation-summary="ModelOnly" class="notice notice-error" role="alert"></div>
    @if (serviceId.HasValue)
    {
        <input type="hidden" name="id" value="@serviceId" />
    }
    <div class="field">
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="Price"></label>
        <input asp-for="Price" type="number" step="0.01" min="0.01" />
        <p class="hint">Si cambiás el precio, se aplica a los turnos nuevos: los precios ya acordados no cambian.</p>
        <span asp-validation-for="Price" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="DurationMinutes"></label>
        <input asp-for="DurationMinutes" type="number" min="1" />
        <span asp-validation-for="DurationMinutes" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="MaxCapacity"></label>
        <input asp-for="MaxCapacity" type="number" min="1" />
        <p class="hint">Cupo 1 es un turno individual; más de 1 es una clase. Con turnos o clases ya registrados, no se puede cambiar entre uno y otro.</p>
        <span asp-validation-for="MaxCapacity" class="field-error"></span>
    </div>
    <div class="actions">
        <button type="submit" class="btn btn-primary">@(serviceId.HasValue ? "Guardar cambios" : "Crear servicio")</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model WorkerRowViewModel
<li class="row row-flat">
    <div class="row-main">
        <div class="row-title">
            <strong>@Model.FullName</strong>
            <partial name="_StatusTag" model="Model.IsActive ? StatusTag.Active : StatusTag.Archived" />
        </div>
        <p class="row-sub">@Model.MaskedPhone · @Model.ScheduleSummary</p>
        <div class="row-actions">
            <a class="btn-link" asp-action="EditWorker" asp-route-id="@Model.Id">@Icons.Svg("edit", "icon-sm") Editar</a>
            @if (Model.IsActive)
            {
                <form method="post" asp-action="ArchiveWorker" asp-route-id="@Model.Id" data-confirm="¿Archivar esta trabajadora?">
                    <button type="submit" class="btn-link">@Icons.Svg("pause", "icon-sm") Archivar</button>
                </form>
            }
            else
            {
                <form method="post" asp-action="ReactivateWorker" asp-route-id="@Model.Id">
                    <button type="submit" class="btn-link">@Icons.Svg("check-double", "icon-sm") Reactivar</button>
                </form>
            }
        </div>
    </div>
</li>

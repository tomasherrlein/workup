@model List<WorkerRowViewModel>
@{
    ViewData["Title"] = "Trabajadoras y horarios";
}
<div class="page-header">
    <div>
        <h1>Trabajadoras y horarios</h1>
    </div>
    <a class="btn btn-primary" asp-action="CreateWorker">@Icons.Svg("plus") Nueva trabajadora</a>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <p>Todavía no cargaste trabajadoras.</p>
    </div>
}
else
{
    <ul class="rows">
        @foreach (var worker in Model)
        {
            <partial name="_WorkerRow" model="worker" />
        }
    </ul>
}

@using WorkUp.Domain.Enums
@model WorkUp.Areas.Owner.Models.Agenda.AgendaIndexViewModel
@{
    ViewData["Title"] = "Agenda";
    var rangeEnd = Model.Agenda.RangeEndExclusive.AddDays(-1);
    var rangeLabel = Model.Period == WorkUp.BusinessLogic.Scheduling.OwnerAgendaPeriod.Week
        ? $"{Formatting.LongDate(Model.Agenda.RangeStart)} — {Formatting.LongDate(rangeEnd)}"
        : Formatting.LongDate(Model.Agenda.SelectedDate);
}
<div class="page-header">
    <div>
        <h1>Agenda</h1>
        <p>@rangeLabel</p>
    </div>
</div>

<form method="get" class="agenda-filters" aria-label="Filtros de agenda">
    <div class="field">
        <label for="date">Fecha</label>
        <input id="date" name="date" type="date" value="@Model.Agenda.SelectedDate.ToString("yyyy-MM-dd")" />
    </div>
    <div class="field">
        <label for="period">Vista</label>
        <select id="period" name="period">
            <option value="Day" selected="@(Model.Period == WorkUp.BusinessLogic.Scheduling.OwnerAgendaPeriod.Day)">Día</option>
            <option value="Week" selected="@(Model.Period == WorkUp.BusinessLogic.Scheduling.OwnerAgendaPeriod.Week)">Semana</option>
        </select>
    </div>
    <div class="field">
        <label for="workerId">Trabajadora</label>
        <select id="workerId" name="workerId">
            <option value="">Todas</option>
            @foreach (var worker in Model.Agenda.Workers)
            {
                <option value="@worker.Id" selected="@(Model.WorkerId == worker.Id)">@worker.Name</option>
            }
        </select>
    </div>
    <div class="field">
        <label for="status">Estado de la anotación</label>
        <select id="status" name="status">
            <option value="" selected="@(Model.BookingStatus is null)">Todos</option>
            <option value="Pending" selected="@(Model.BookingStatus == BookingStatus.Pending)">Pendiente</option>
            <option value="Confirmed" selected="@(Model.BookingStatus == BookingStatus.Confirmed)">Confirmado</option>
            <option value="Attended" selected="@(Model.BookingStatus == BookingStatus.Attended)">Atendido</option>
            <option value="Absent" selected="@(Model.BookingStatus == BookingStatus.Absent)">Ausente</option>
            <option value="Cancelled" selected="@(Model.BookingStatus == BookingStatus.Cancelled)">Cancelado</option>
        </select>
    </div>
    <div class="field">
        <label for="origin">Origen del turno</label>
        <select id="origin" name="origin">
            <option value="" selected="@(Model.Origin is null)">Todos</option>
            <option value="Reserved" selected="@(Model.Origin == AppointmentOrigin.Reserved)">Reservado</option>
            <option value="WalkIn" selected="@(Model.Origin == AppointmentOrigin.WalkIn)">Sin reserva</option>
        </select>
    </div>
    <button type="submit" class="btn-primary">Aplicar filtros</button>
</form>

@if (Model.Agenda.Entries.Count == 0)
{
    <div class="empty-state"><p>No hay turnos ni clases para este período y estos filtros.</p></div>
}
else
{
    <ul class="rows" aria-label="Turnos y clases">
        @foreach (var entry in Model.Agenda.Entries)
        {
            var originLabel = entry.Origin switch
            {
                AppointmentOrigin.Reserved => "Reservado",
                AppointmentOrigin.WalkIn => "Sin reserva",
                _ => null
            };
            var kindLabel = entry.Kind == AppointmentKind.Individual ? "Turno individual" : "Clase de la semana";
            <li class="row">
                <div class="row-time">
                    <time datetime="@entry.StartsAt.ToString("yyyy-MM-dd'T'HH:mm:ss")">@Formatting.Time(entry.StartsAt)</time>
                    <span class="end">Hasta @Formatting.Time(entry.EndsAt)</span>
                </div>
                <div class="row-main">
                    <div class="row-title">
                        <strong>@entry.ServiceName · @(entry.ClientName ?? (entry.BookingId is null ? "Sin anotaciones" : "Cliente"))</strong>
                    </div>
                    <div class="row-sub">@entry.WorkerName · @kindLabel@if (originLabel is not null) { <text> · @originLabel</text> }</div>
                    <div class="row-tags">
                        <partial name="_StatusTag" model="StatusTag.For(entry.AppointmentStatus)" />
                        @if (entry.BookingStatus is { } bookingStatus)
                        {
                            <partial name="_StatusTag" model="StatusTag.For(bookingStatus)" />
                        }
                    </div>
                    @if (entry.Kind == AppointmentKind.Individual && entry.BookingId is { } bookingId)
                    {
                        <div class="row-actions">
                            <a class="btn" asp-action="Detail" asp-route-id="@bookingId">Ver detalle del turno</a>
                        </div>
                    }
                </div>
            </li>
        }
    </ul>
}

@using WorkUp.Domain.Enums
@using WorkUp.BusinessLogic.Scheduling
@model WorkUp.Areas.Owner.Models.Agenda.AgendaIndexViewModel
@{
    ViewData["Title"] = "Agenda";
    var rangeEnd = Model.Agenda.RangeEndExclusive.AddDays(-1);
    var rangeLabel = Model.IsWeek
        ? $"{Formatting.LongDate(Model.Agenda.RangeStart)} — {Formatting.LongDate(rangeEnd)}"
        : Formatting.LongDate(Model.Agenda.SelectedDate);
}
<div class="page-header">
    <div>
        <h1>Agenda</h1>
        <p>@rangeLabel</p>
    </div>
    <a class="btn-primary" asp-action="NewBooking">Anotar turno individual</a>
</div>

<ul class="nav-inline" aria-label="Navegar por fecha">
    <li><a class="btn-link" asp-action="Index" asp-all-route-data="Model.Query(Model.PreviousDate)">@Icons.Svg("arrow-left") Anterior</a></li>
    <li><a class="btn-link" asp-action="Index" asp-all-route-data="Model.Query(Model.NextDate)">Siguiente @Icons.Svg("arrow-right")</a></li>
    <li>
        <a class="btn" asp-action="Index" asp-all-route-data="Model.Query(period: Model.IsWeek ? OwnerAgendaPeriod.Day : OwnerAgendaPeriod.Week)">
            Ver por @(Model.IsWeek ? "día" : "semana")
        </a>
    </li>
</ul>

<form method="get" class="agenda-filters" aria-label="Filtros de agenda">
    <div class="field">
        <label for="date">Fecha</label>
        <input id="date" name="date" type="date" value="@Model.Agenda.SelectedDate.ToString("yyyy-MM-dd")" />
    </div>
    <input type="hidden" name="period" value="@Model.Period" />
    <div class="field">
        <label for="workerId">Trabajadora</label>
        <select id="workerId" name="workerId">
            <option value="">Todas</option>
            @foreach (var worker in Model.Agenda.Workers)
            {
                <option value="@worker.Id" selected="@(Model.WorkerId == worker.Id)">@worker.Name</option>
            }
        </select>
    </div>
    <div class="field">
        <label for="status">Estado de la anotación</label>
        <select id="status" name="status">
            <option value="" selected="@(Model.BookingStatus is null)">Todos</option>
            <option value="Pending" selected="@(Model.BookingStatus == BookingStatus.Pending)">Pendiente</option>
            <option value="Confirmed" selected="@(Model.BookingStatus == BookingStatus.Confirmed)">Confirmado</option>
            <option value="Attended" selected="@(Model.BookingStatus == BookingStatus.Attended)">Atendido</option>
            <option value="Absent" selected="@(Model.BookingStatus == BookingStatus.Absent)">Ausente</option>
            <option value="Cancelled" selected="@(Model.BookingStatus == BookingStatus.Cancelled)">Cancelado</option>
        </select>
    </div>
    <div class="field">
        <label for="origin">Origen del turno</label>
        <select id="origin" name="origin">
            <option value="" selected="@(Model.Origin is null)">Todos</option>
            <option value="Reserved" selected="@(Model.Origin == AppointmentOrigin.Reserved)">Reservado</option>
            <option value="WalkIn" selected="@(Model.Origin == AppointmentOrigin.WalkIn)">Sin reserva</option>
        </select>
    </div>
    <button type="submit" class="btn">Aplicar filtros</button>
</form>

@if (Model.HasFilters)
{
    <ul class="nav-inline" aria-label="Filtros activos">
        @if (Model.WorkerId is not null)
        {
            <li>
                <a class="btn-link" asp-action="Index" asp-all-route-data="Model.Query(keepWorker: false)" aria-label="Quitar filtro: @Model.WorkerName">
                    @Icons.Svg("cross") @Model.WorkerName
                </a>
            </li>
        }
        @if (Model.BookingStatus is not null)
        {
            var statusLabel = StatusTag.For(Model.BookingStatus.Value).Label;
            <li>
                <a class="btn-link" asp-action="Index" asp-all-route-data="Model.Query(keepStatus: false)" aria-label="Quitar filtro: @statusLabel">
                    @Icons.Svg("cross") <partial name="_StatusTag" model="StatusTag.For(Model.BookingStatus.Value)" />
                </a>
            </li>
        }
        @if (Model.Origin is not null)
        {
            var originLabel = Model.Origin == AppointmentOrigin.Reserved ? "Reservado" : "Sin reserva";
            <li>
                <a class="btn-link" asp-action="Index" asp-all-route-data="Model.Query(keepOrigin: false)" aria-label="Quitar filtro: @originLabel">
                    @Icons.Svg("cross") @originLabel
                </a>
            </li>
        }
    </ul>
}

@if (Model.Agenda.Entries.Count == 0)
{
    <div class="empty-state">
        <p>No hay turnos ni clases para este período@(Model.HasFilters ? " y estos filtros" : "").</p>
        @if (Model.HasFilters)
        {
            <a class="btn" asp-action="Index"
               asp-all-route-data="Model.Query(keepWorker: false, keepStatus: false, keepOrigin: false)">
                Limpiar filtros
            </a>
        }
    </div>
}
else if (Model.IsWeek)
{
    @foreach (var day in Model.EntriesByDay)
    {
        <div class="section">
            <div class="section-header"><h2>@Formatting.LongDate(day.Key)</h2></div>
            <ul class="rows" aria-label="Turnos y clases del @Formatting.LongDate(day.Key)">
                @foreach (var entry in day)
                {
                    <partial name="_AgendaRow" model="entry" />
                }
            </ul>
        </div>
    }
}
else
{
    <ul class="rows" aria-label="Turnos y clases">
        @foreach (var entry in Model.Agenda.Entries)
        {
            <partial name="_AgendaRow" model="entry" />
        }
    </ul>
}
